{
	"schemaVersion": 1,
	"id": "mythic_rpg_compat",
	"version": "${version}",
	"name": "RPG Gear Upgrades",
	"description": "Endgame upgrades for RPG Series gear: Mythic Upgrades gem infusion and Ruby/Aeternium forging from Better Nether and Better End.",
	"authors": ["jens-hj"],
	"contact": {
		"sources": "https://github.com/jens-hj/mythic-rpg-compat",
		"issues": "https://github.com/jens-hj/mythic-rpg-compat/issues"
	},
	"license": "MIT",
	"icon": "assets/mythic_rpg_compat/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.jensh.mythicrpgcompat.MythicRpgCompat"],
		"client": ["dev.jensh.mythicrpgcompat.client.MythicRpgCompatClient"],
		"modmenu": ["dev.jensh.mythicrpgcompat.client.config.ModMenuIntegration"]
	},
	"mixins": [
		"mythic_rpg_compat.mixins.json",
		{
			"config": "mythic_rpg_compat.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"armor_model_api": ">=1.1.2"
	},
	"recommends": {
		"mythicupgrades": ">=5.1.1",
		"betterend": "*",
		"betternether": "*",
		"archers": "*",
		"paladins": "*",
		"wizards": "*",
		"rogues": "*",
		"jewelry": "*"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}
